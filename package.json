{
  "name": "mangwonbob",
  "version": "2.0.0",
  "private": true,
  "description": "망원밥 v2 — 몬스테라하우스 저녁 추천·번개 슬랙 앱",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test src/*/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import-legacy": "tsx src/scripts/import-legacy.ts",
    "collect": "tsx src/scripts/collect.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.2.0",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
