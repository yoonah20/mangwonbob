# Slack App 설정
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# 카카오 Developers REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# DeepSeek API 키 (추천 코멘트 생성용)
DEEPSEEK_API_KEY=sk-your-deepseek-key
# (선택) 모델/엔드포인트 오버라이드
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# PostgreSQL 연결 문자열 (Railway에서 자동 주입)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# 서버 포트
PORT=3000

# 지도 뷰용 (카카오 JavaScript 키 — REST API 키와 다름)
KAKAO_JS_API_KEY=your-kakao-javascript-key
# Railway에서 발급된 공개 URL (예: https://mangwonbob-production.up.railway.app)
PUBLIC_URL=

# 점심 모집 기본 채널 (선택 — 미설정 시 /밥 호출한 채널로 공지)
# 월 1회 자동 수집 완료 시 신규 식당 공지도 이 채널로 전송됩니다.
MEETUP_CHANNEL_ID=

# 월 1회 자동 식당 수집 끄기 (선택 — 1로 설정하면 자동 수집 비활성화)
# DISABLE_AUTO_COLLECT=1
