# Slack App 설정
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# 카카오 Developers REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# DeepSeek API 키 (추천 코멘트 생성용)
DEEPSEEK_API_KEY=sk-your-deepseek-key
# (선택) 모델/엔드포인트 오버라이드
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# PostgreSQL 연결 문자열 (Railway에서 자동 주입)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# 서버 포트
PORT=3000

# 지도 뷰용 (카카오 JavaScript 키 — REST API 키와 다름)
KAKAO_JS_API_KEY=your-kakao-javascript-key
# Railway에서 발급된 공개 URL (예: https://mangwonbob-production.up.railway.app)
PUBLIC_URL=
