# ── 슬랙 (새 앱, Socket Mode) ── slack-manifest.yml 로 앱을 만든 뒤 발급
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 명령어 이름. 기존 v1 앱이 /밥 을 쓰는 동안 같은 워크스페이스에서 시험하려면 /밥2 등으로 바꿔 두세요.
SLASH_COMMAND=/밥
# 주간 소식(금요일 16:30)을 올릴 채널 ID. 비워 두면 보내지 않음
BOB_CHANNEL_ID=

# ── DB ── Railway Postgres가 자동으로 넣어 줌
DATABASE_URL=postgres://user:pass@host:5432/mangwonbob
# 기존 데이터 옮길 때만 (npm run import-legacy)
LEGACY_DATABASE_URL=

# ── 카카오 로컬 API (REST 키) ── 식당 수집
KAKAO_REST_API_KEY=

# ── 구글 Places API (New) ── 평점. 없으면 평점 없이 추천
GOOGLE_PLACES_API_KEY=
# 등급별 월 호출 상한 (무료 한도 1,000건보다 낮게)
GOOGLE_MONTHLY_LIMIT=900

# ── 웹 ──
# 이 서버의 공개 주소. 있으면 슬랙 카드에 종류 타일 이미지가 붙음
PUBLIC_URL=
PORT=3000
# 월간 카카오 수집 끄기
# DISABLE_AUTO_COLLECT=1
